# 青野后端环境变量示例（复制为 .env 后按需修改）
PORT=8081
DB_PATH=./data/qingye.db
UPLOAD_DIR=./uploads
# 允许跨域的前端源，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=10
# 可选：Plantbook 在线植物资料库（open.plantbook.io 注册后在 API keys 页生成）
# 填 OAuth2 凭据 client_id + client_secret，两者都配置后启用在线匹配与批量同步
PLANTBOOK_CLIENT_ID=
PLANTBOOK_CLIENT_SECRET=
# 可选：直接使用的 access_token（对应官方 PLANTBOOK_ACCESS_TOKEN，一般无需填写）
PLANTBOOK_ACCESS_TOKEN=

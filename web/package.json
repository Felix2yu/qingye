{
  "name": "qingye-web",
  "packageManager": "pnpm@11.22.0",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "env -u http_proxy -u https_proxy -u all_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.6.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.4",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "cookie": "^2.0.1"
  }
}
